{
  "name": "anti-yapping",
  "version": "0.2.1",
  "license": "MIT",
  "description": "Stop AI yapping. Line 1 telegraphic answers, surgical diffs only, zero fluff, and up to 80% output token savings for AI coding agents.",
  "type": "module",
  "bin": {
    "anti-yapping": "dist/cli.js"
  },
  "files": [
    "dist",
    "profiles",
    "personas",
    "culture",
    "core",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humanoiseLABS/anti-yapping.git"
  },
  "bugs": {
    "url": "https://github.com/humanoiseLABS/anti-yapping/issues"
  },
  "homepage": "https://github.com/humanoiseLABS/anti-yapping#readme",
  "keywords": [
    "coding-agent",
    "anti-yapping",
    "token-efficiency",
    "claude-code",
    "antigravity",
    "opencode",
    "cursor",
    "indonesia"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "prepublishOnly": "npm run bundle",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build": "node src/cli.ts build --profile anti-yapping --adapter fake",
    "measure": "node src/cli.ts measure --profile anti-yapping",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "gpt-tokenizer": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
