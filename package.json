{
  "name": "@humanoiselabs/token-maxxing",
  "version": "0.3.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Stop AI yapping, start token-maxxing. Line 1 telegraphic answers, surgical diffs, 3D neural telemetry HUD, and extreme token savings for AI coding agents.",
  "type": "module",
  "bin": {
    "token-maxxing": "dist/cli.js",
    "tmx": "dist/cli.js",
    "anti-yapping": "dist/cli.js"
  },
  "files": [
    "dist",
    "profiles",
    "personas",
    "culture",
    "core",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humanoiseLABS/token-maxxing.git"
  },
  "bugs": {
    "url": "https://github.com/humanoiseLABS/token-maxxing/issues"
  },
  "homepage": "https://github.com/humanoiseLABS/token-maxxing#readme",
  "keywords": [
    "token-maxxing",
    "tmx",
    "anti-yapping",
    "second-brain",
    "coding-agent",
    "token-efficiency",
    "claude-code",
    "antigravity",
    "opencode",
    "cursor",
    "telemetry",
    "indonesia"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "prepublishOnly": "npm run bundle",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "build": "node src/cli.ts build --profile token-maxxing --adapter fake",
    "measure": "node src/cli.ts measure --profile token-maxxing",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "gpt-tokenizer": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}